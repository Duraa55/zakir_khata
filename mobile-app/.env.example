# Local development only. EAS BUILDS DO NOT USE THIS FILE — they take their values
# from the EAS environment named by each profile's "environment" field in eas.json,
# so no key is ever committed.
#
# To populate this for local development, pull your own values rather than pasting them:
#     npx eas env:pull --environment development
# which writes .env.local (gitignored, and higher precedence than .env).
# Values marked "Secret" on expo.dev cannot be read back and must be entered by hand.
#
# Only FIREBASE_API_KEY and FIREBASE_PROJECT_ID decide IS_FIREBASE_CONFIGURED
# (src/services/firebase/firebaseConfig.ts). app.config.js maps every name below into
# expo.extra.firebase*, which is what the app actually reads.
#
# NOTE: FIREBASE_APP_ID should come from a WEB app in the Firebase console. The app id in
# google-services.json is the ANDROID one, and this project uses the firebase JS (web) SDK.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
