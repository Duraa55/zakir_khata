# Line endings are normalised to LF in the repo and in the working tree.
#
# Without this, core.autocrlf=true on Windows checks every file out as CRLF, which
# silently breaks any test asserting on multi-line source markup: a regex written
# with \n cannot consume the \r. Regression check 83 failed for exactly that reason
# on a file nobody had edited.
* text eol=lf

# Binaries must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary
*.pdf binary
*.zip binary
*.hbc binary
